generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PriorityLevel {
  URGENT
  NORMAL
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("master") // user, manager, admin
  createdAt DateTime @default(now())
  employee  Employee?
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?  @unique
  createdAt DateTime @default(now())
  orders    Order[]
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  specialization String?
  duration    Int      // в минутах
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Employee {
  id             Int      @id @default(autoincrement())
  name           String
  specialization String   
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  userId         Int      @unique // Уникально, чтобы один юзер мог быть только одним сотрудником
  orders         Order[]
}

model Order {
  id             Int        @id @default(autoincrement())
  customerId     Int
  customer       Customer   @relation(fields: [customerId], references: [id])
  serviceId      Int
  service        Service    @relation(fields: [serviceId], references: [id])
  employeeId     Int?
  employee       Employee?  @relation(fields: [employeeId], references: [id])
  vehicleId      Int?
  vehicle        Vehicle?   @relation(fields: [vehicleId], references: [id])
  preferredTime  DateTime
  duration       Int
  status         String     @default("pending") // pending, in_progress, completed
  priority       PriorityLevel  @default(NORMAL)
  createdAt      DateTime   @default(now())
}

model Vehicle {
  id          Int      @id @default(autoincrement())
  plateNumber String   @unique // госномер
  model       String   // например, "Mercedes Sprinter"
  year        Int
  status      String   @default("in_service") // in_service, in_repair, out_of_order
  createdAt   DateTime @default(now())
  orders      Order[]
}